# Workspace repo — tracks ONLY the shared project context at this level.
#
# This is deliberately NOT a monorepo. Each app under apps/ is its own independent git
# repository with its own CodeCommit remote; they are ignored here so the two never overlap.
# The only job of this repo is to carry CLAUDE.md and the project docs between the Windows
# design machine and the CM4, so hardware corrections reach future design sessions.

# The app repositories — each is independently versioned
apps/

# Vendor SDK: ~175KB jar plus architecture-specific .so binaries. Licensed material,
# not ours to redistribute, and it has its own versioning (API-linux-java-vNNNNNN).
API-linux-java-*/

# Datasheets and manuals — large binaries, supplied by the vendor
Hardware/

# Files the desktop bridge could not delete
_to_delete/

# Build output and local scratch
target/
*.jar
*.log
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
