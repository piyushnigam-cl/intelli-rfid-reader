# This repo holds the workspace-level documentation ONLY.
#
# Each app under apps/ is its own git repository with its own CodeCommit remote
# (see CLAUDE.md, "Repository layout"). They are excluded here so that this repo
# never spans apps/ - nesting them would need submodules and would break the
# one-repo-per-app rule the project is built on.
apps/

# Vendor SDK and datasheets are copied in separately, not tracked (CLAUDE.md).
# Globbed so a newer SDK drop is ignored without editing this file.
API-linux-java-*/
Hardware/

# Files the desktop bridge could not delete
_to_delete/

# Build output and local scratch
target/
*.jar
*.bak
*.log

# Transfer bundles - large, regenerated on demand, never source of truth
*.tar.gz
*.tgz

# Editors and OS cruft
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Word lock files - present while a .docx in docs/ is open
~$*

# Transient credential handoff file - never commit, deleted after use
.git-creds-temp
